# Copy to .env and change the passwords. .env is git-ignored.
# Both services and docker-compose read this file.

POSTGRES_PASSWORD=change-me-postgres
PRICING_DB_PASSWORD=change-me-pricing
RESERVATION_DB_PASSWORD=change-me-reservation

# Host ports (chosen to avoid clashing with other local projects)
POSTGRES_PORT=5442
REDIS_PORT=6390

PROMETHEUS_PORT=9091
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=change-me-grafana
